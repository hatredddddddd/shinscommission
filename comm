local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local root = character:WaitForChild("HumanoidRootPart")

local ball = workspace:WaitForChild("Basketball")

-- Vertical hitbox
local MIN_ABOVE = 14
local MAX_ABOVE = 50

-- Horizontal distance
local MAX_DISTANCE = 18

-- X offset
local X_OFFSET = 0

local wasInRange = false

-- Toggle settings
local enabled = false
local xWasDown = false

-- Refresh root every 15 seconds
task.spawn(function()
	while true do
		task.wait(15)

		local newCharacter = player.Character
		if newCharacter then
			local newRoot = newCharacter:FindFirstChild("HumanoidRootPart")
			if newRoot then
				root = newRoot
			end
		end
	end
end)

RunService.Heartbeat:Connect(function()
	-- X toggle
	local xIsDown = iskeypressed(0x58)

	if xIsDown and not xWasDown then
		enabled = not enabled

		if enabled then
			print("folk block on")
		else
			print("folk block off")
		end
	end

	xWasDown = xIsDown

	if not enabled then
		return
	end

	if not ball or not ball.Parent then
		return
	end

	local ok, err = pcall(function()
		local ballPosition = ball.Position + Vector3.new(X_OFFSET, 0, 0)
		local playerPosition = root.Position

		local heightAbove = ballPosition.Y - playerPosition.Y

		local horizontalDistance = Vector3.new(
			ballPosition.X - playerPosition.X,
			0,
			ballPosition.Z - playerPosition.Z
		).Magnitude

		local ballIsAboveMe =
			heightAbove >= MIN_ABOVE
			and heightAbove <= MAX_ABOVE

		local ballIsCloseEnough =
			horizontalDistance <= MAX_DISTANCE

		local inRange =
			ballIsAboveMe
			and ballIsCloseEnough

		if inRange and not wasInRange then
			wasInRange = true

			print("ball above me — jumping")

			task.spawn(function()
				keypress(0x20)
				task.wait(0.05)
				keyrelease(0x20)
			end)
		end

		if not inRange then
			wasInRange = false
		end
	end)

	if not ok then
		warn("yo them errors tried to fuck u up but pcall got ur back:", err)
	end
end)
